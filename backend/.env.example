NODE_ENV=development
PORT=4000

# Supabase Postgres connection string.
# Use the DIRECT connection (port 5432) if you need long-lived sessions,
# or the pooled "Transaction" mode connection (port 6543) for normal API traffic.
# Our transactions are short-lived (single request), so transaction-mode pooling is fine.
# Example direct:   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example pooled:   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seatlock
DATABASE_SSL=false
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

RESERVATION_TTL_SECONDS=300

PAYMENT_PROVIDER=mock
PAYMENT_SECRET=mock_payment_secret
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
