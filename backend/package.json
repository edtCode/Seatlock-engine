{
  "name": "seatlock-backend",
  "version": "1.0.0",
  "description": "High-concurrency event seat reservation backend (SeatLock)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "migrate": "node database/scripts/migrate.js",
    "migrate:down": "node database/scripts/migrate.js down",
    "seed": "node database/seeds/seed.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:unit": "NODE_ENV=test jest tests/unit --runInBand",
    "test:api": "NODE_ENV=test jest tests/api --runInBand",
    "test:concurrency": "NODE_ENV=test jest tests/concurrency --runInBand --testTimeout=60000",
    "lint": "echo \"(add eslint if desired)\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "qrcode": "^1.5.4",
    "express-rate-limit": "^7.4.0",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "pino-pretty": "^11.2.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
